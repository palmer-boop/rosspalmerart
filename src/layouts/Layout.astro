---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '../styles.css';
import { site, collections, enquiryLink } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  current?: string;
}
const { title, description = site.description, image, current = '' } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Paintings of Ireland and Zimbabwe`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const nav = [
  { href: `/${collections.irish.slug}/`, label: collections.irish.name, key: 'irish' },
  { href: `/${collections.african.slug}/`, label: collections.african.name, key: 'african' },
  { href: '/about-me/', label: 'My Story', key: 'about' },
  { href: '/contact/', label: 'Contact', key: 'contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f1" />
    <meta name="msvalidate.01" content="46DDC1B93C7F284A7D2584EB63A6F18F" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Fragment set:html={"<!--email_off-->"} />
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label={`${site.name}, home`}><b>{site.artist}</b><small>Paintings · Cork</small></a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-top">
          <a class="wordmark" href="/" aria-label={`${site.name}, home`}><b>{site.artist}</b><small>Paintings of Ireland and Zimbabwe</small></a>
          <div class="foot-col">
            <p class="eyebrow">The work</p>
            {nav.slice(0, 3).map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
          <div class="foot-col">
            <p class="eyebrow">Enquiries</p>
            <a href={enquiryLink('Enquiry from rosspalmerart.com')}>{site.email}</a>
            <span>{site.location}</span>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {new Date().getFullYear()} {site.name}</span>
          <span>All paintings by {site.artist}</span>
        </div>
      </div>
    </footer>

    <script>
      let onScroll: (() => void) | undefined;

      function setup() {
        document.documentElement.classList.add('js');

        // Hairline under the header once the page scrolls
        const header = document.querySelector('.site-header');
        if (onScroll) window.removeEventListener('scroll', onScroll);
        onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 8);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // Fade elements in as they scroll into view
        const items = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add('is-in');
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          items.forEach((el) => io.observe(el));
        }

        // "On the wall" / "In a room" switch on painting pages
        const switches = document.querySelectorAll<HTMLButtonElement>('[data-view]');
        switches.forEach((btn) => {
          btn.addEventListener('click', () => {
            switches.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
            document.querySelectorAll<HTMLElement>('.view').forEach((v) => (v.hidden = v.dataset.pane !== btn.dataset.view));
          });
        });

        // Videos: swap the poster for the YouTube player only when someone presses play
        document.querySelectorAll<HTMLElement>('.video[data-video]').forEach((box) => {
          const btn = box.querySelector<HTMLButtonElement>('.video-play');
          if (!btn || box.dataset.ready) return;
          box.dataset.ready = '1';
          btn.addEventListener('click', () => {
            const f = document.createElement('iframe');
            f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.video}?autoplay=1&rel=0&modestbranding=1`;
            f.title = box.dataset.title ?? 'Video';
            f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
            f.allowFullscreen = true;
            box.replaceChildren(f);
          });
        });

        // Click-to-zoom view on painting pages
        const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
        const openers = document.querySelectorAll<HTMLElement>('[data-zoom]');
        if (dialog && openers.length && !dialog.dataset.ready) {
          dialog.dataset.ready = '1';
          const stage = dialog.querySelector<HTMLElement>('.lightbox-stage')!;
          const close = () => {
            dialog.classList.remove('is-zoomed');
            dialog.close();
          };
          openers.forEach((o) => o.addEventListener('click', () => dialog.showModal()));
          dialog.querySelector('.lightbox-close')!.addEventListener('click', close);
          dialog.addEventListener('close', () => dialog.classList.remove('is-zoomed'));
          stage.addEventListener('click', (ev) => {
            const zoomed = dialog.classList.toggle('is-zoomed');
            if (zoomed) {
              const fx = ev.clientX / window.innerWidth;
              const fy = ev.clientY / window.innerHeight;
              requestAnimationFrame(() => {
                dialog.scrollLeft = (dialog.scrollWidth - dialog.clientWidth) * fx;
                dialog.scrollTop = (dialog.scrollHeight - dialog.clientHeight) * fy;
              });
            }
          });
        }
      }
      document.addEventListener('astro:page-load', setup);
    </script>
    <Fragment set:html={"<!--/email_off-->"} />
  </body>
</html>
