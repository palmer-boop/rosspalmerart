---
/*
  A painting in a picture frame with a white mount, drawn in CSS.
  The photo itself is never cropped or altered.
  Frame and mount widths are a share of the frame's own width, so they scale with it.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type FrameStyle = 'black' | 'oak' | 'gold';

interface Props {
  src: ImageMetadata;
  alt: string;
  frame?: FrameStyle;
  widths?: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  transitionName?: string;
  /** Tallest the whole frame may be, as a CSS length (e.g. "min(72vh, 780px)") */
  maxHeight?: string;
  /** Widest the whole frame may be, as a CSS length. Defaults to 100% */
  maxWidth?: string;
  /** Moulding and mount widths, in % of the frame width */
  moulding?: number;
  mount?: number;
  class?: string;
  style?: string;
}
const {
  src, alt, frame = 'black', sizes, loading = 'lazy', priority = false, transitionName,
  maxHeight, maxWidth = '100%', moulding = 4.2, mount = 7, class: cls = '', style = '',
} = Astro.props;

const ws = (Astro.props.widths ?? [360, 560, 800, 1100, 1600]).filter((w) => w <= src.width);
const widths = ws.length ? ws : [src.width];

// Width that makes the whole frame (moulding + mount + painting) exactly maxHeight tall
const k = (moulding + mount) / 100;
const ratio = src.width / src.height;
const factor = (1 - 2 * k) / ratio + 2 * k;
const width = maxHeight ? `min(${maxWidth}, calc(${maxHeight} / ${factor.toFixed(4)}))` : maxWidth;
---
<span
  class={`framed ${cls}`}
  style={`width:${width};--fb:${moulding}cqi;--mp:${mount}cqi;${style}`}
>
  <span class={`frame frame--${frame}`}>
    <span class="mat">
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={priority ? 'high' : undefined}
        transition:name={transitionName}
      />
    </span>
  </span>
</span>
