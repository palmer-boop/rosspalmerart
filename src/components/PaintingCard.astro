---
import Frame from './Frame.astro';
import { imageFor, details, frameFor, type Painting } from '../data/paintings';

interface Props { painting: Painting; index?: number; number?: number; }
const { painting: p, index = 0, number } = Astro.props;
const img = imageFor(p.slug);
const meta = details(p);
---
<a class="card" href={`/${p.slug}/`} data-reveal style={`--d:${(index % 3) * 110}ms`}>
  <span class="card-art">
    <Frame
      src={img}
      alt={p.alt}
      frame={frameFor(p)}
      sizes="(max-width: 640px) 80vw, (max-width: 1000px) 40vw, 340px"
      transitionName={`art-${p.slug}`}
    />
  </span>
  <span class="card-text">
    {number !== undefined && <span class="card-num">{String(number).padStart(2, '0')}</span>}
    <span class="card-title">{p.title}</span>
    {meta && <span class="card-meta">{meta}</span>}
  </span>
</a>
