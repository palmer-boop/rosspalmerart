---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PaintingCard from '../components/PaintingCard.astro';
import Frame from '../components/Frame.astro';
import Video from '../components/Video.astro';
import { paintings, imageFor, frameFor } from '../data/paintings';
import { collections, enquiryLink, type CollectionKey } from '../data/site';

const hero = paintings.find((p) => p.slug === 'ladies-to-market')!;
const heroImg = imageFor(hero.slug);
const og = await getImage({ src: heroImg, width: 1200, format: 'jpg' });
const selected = paintings.filter((p) => p.featured && p.slug !== hero.slug).slice(0, 9);
const keys = Object.keys(collections) as CollectionKey[];
const count = (k: CollectionKey) => paintings.filter((p) => p.collection === k).length;
const numerals = ['I', 'II'];
---
<Layout image={og.src}>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Paintings of Ireland and Zimbabwe</p>
      <h1>Memories of two homes, <em>recorded in paint.</em></h1>
      <p class="body">
        My journey through art has been to record memories from a life lived in Zimbabwe and Ireland, mostly in
        acrylics on canvas, with a few watercolours.
      </p>
      <div class="hero-actions">
        <a class="btn btn-solid" href="#works">View the paintings</a>
        <a class="caps link-arrow" href="/about-me/">My story <span>→</span></a>
      </div>
    </div>
    <figure class="hero-art lit-wall">
      <a class="hang" href={`/${hero.slug}/`} aria-label={`${hero.title}, view the painting`}>
        <span class="picture-light" aria-hidden="true"></span>
        <Frame
          src={heroImg}
          alt={hero.alt}
          frame={frameFor(hero)}
          widths={[640, 960, 1300, 1800]}
          sizes="(max-width: 900px) 84vw, 46vw"
          loading="eager"
          priority
          maxHeight="min(62vh, 640px)"
          transitionName={`art-${hero.slug}`}
        />
      </a>
      <figcaption><em>{hero.title}</em> &nbsp; {collections[hero.collection].name}</figcaption>
    </figure>
  </section>

  <section class="wrap statement" data-reveal>
    <p class="eyebrow">Since 2017</p>
    <p class="big">
      The people, villages and wildlife of <em>Zimbabwe</em>, and the coast, churches and bridges of{' '}
      <em>Cork</em>: the two places I have called home.
    </p>
    <span class="rule" aria-hidden="true"></span>
  </section>

  <section class="wrap section" style="padding-top:0">
    <div class="collections">
      {keys.map((k, i) => (
        <a class="collection" href={`/${collections[k].slug}/`} data-reveal style={`--d:${i * 140}ms`}>
          <span class="collection-img lit-wall">
            <Frame
              src={imageFor(collections[k].cover)}
              alt=""
              frame={k === 'irish' ? 'gold' : 'black'}
              sizes="(max-width: 760px) 70vw, 460px"
            />
          </span>
          <span class="collection-row">
            <span class="collection-num">{numerals[i]}</span>
            <span class="collection-name">{collections[k].name}</span>
            <span class="caps">{count(k)} works</span>
          </span>
          <p>{collections[k].blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section" id="works" style="scroll-margin-top:90px;padding-top:0">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Selected works</p>
        <h2 class="h-section">From the studio</h2>
      </div>
      <a class="caps link-arrow" href={`/${collections.irish.slug}/`}>All paintings <span>→</span></a>
    </div>
    <div class="salon">
      {selected.map((p, i) => <PaintingCard painting={p} index={i} number={i + 1} />)}
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <figure class="band-video" data-reveal>
        <Video id="9_ftfnuBUdw" title="The Artist Next Door" />
        <figcaption><em>The Artist Next Door</em> &nbsp; Ross in conversation · 9 min · Reality Inspiration, 2025</figcaption>
      </figure>
      <div class="band-text" data-reveal style="--d:140ms">
        <p class="eyebrow">My story</p>
        <blockquote>
          “The paintings are a series of memories of the journey through life, both in Zimbabwe and Ireland.”
        </blockquote>
        <p class="body">
          I started painting in 2017 when faced with retirement from the planning and development sector. Having
          been brought up in Zimbabwe, I paint its people, buildings, landscapes and wildlife. Since moving to
          Ireland in 2000, I have tried to record my home town of Glanmire in Cork.
        </p>
        <a class="caps link-arrow" href="/about-me/">Read my story <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="wrap commission" data-reveal>
    <p class="eyebrow">Commissions</p>
    <h2>A home, a view or a moment, <em>painted for you.</em></h2>
    <p>
      I have been asked to prepare a number of private paintings for clients, reflecting their own requests. If
      there is a place you would like painted, get in touch.
    </p>
    <a class="btn" href={enquiryLink('Commission enquiry')}>Enquire about a commission</a>
  </section>
</Layout>
