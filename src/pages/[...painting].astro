---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PaintingCard from '../components/PaintingCard.astro';
import { paintings, imageFor, details, type Painting } from '../data/paintings';
import { collections, site, enquiryLink } from '../data/site';

export function getStaticPaths() {
  return paintings.map((p) => ({ params: { painting: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Painting };
const c = collections[p.collection];
const img = imageFor(p.slug);
const full = await getImage({ src: img, width: Math.min(img.width, 2400), format: 'webp', quality: 86 });
const og = await getImage({ src: img, width: Math.min(img.width, 1200), format: 'jpg' });

const siblings = paintings.filter((x) => x.collection === p.collection);
const at = siblings.findIndex((x) => x.slug === p.slug);
const prev = siblings[(at - 1 + siblings.length) % siblings.length];
const next = siblings[(at + 1) % siblings.length];
const more = [1, 2, 3].map((n) => siblings[(at + 1 + n) % siblings.length]).filter((x) => x.slug !== p.slug);

// Real size in mm, matched to the photo's orientation, for the "In a room" view
const nums = (p.size?.match(/\d+/g) ?? []).map(Number);
const landscape = img.width >= img.height;
const realSize =
  nums.length >= 2
    ? landscape
      ? { w: Math.max(nums[0], nums[1]), h: Math.min(nums[0], nums[1]) }
      : { w: Math.min(nums[0], nums[1]), h: Math.max(nums[0], nums[1]) }
    : null;
// The room view shows a 2.4 m wide, 1.7 m high stretch of wall above a 1.2 m sideboard
const ROOM_W = 2400, ROOM_H = 1700, HANG = 960;

const meta = details(p);
const description = [`${p.title}, a painting by ${site.artist}.`, meta, p.note].filter(Boolean).join(' ');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: p.title,
  creator: { '@type': 'Person', name: site.artist },
  image: new URL(og.src, Astro.site).href,
  url: new URL(`/${p.slug}/`, Astro.site).href,
  ...(p.medium && { artMedium: p.medium }),
  ...(p.year && { dateCreated: String(p.year) }),
  ...(p.size && { size: p.size }),
};
---
<Layout title={p.title} description={description} image={og.src} current={p.collection}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav class="wrap crumbs" aria-label="Breadcrumb">
    <a href="/">Paintings</a>
    <span aria-hidden="true">/</span>
    <a href={`/${c.slug}/`}>{c.name}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{p.title}</span>
  </nav>

  <section class="wall" aria-label="The painting">
    <div class="wall-inner">
      <div class="view" data-pane="wall">
        <button class="zoom" type="button" data-zoom aria-label={`Enlarge ${p.title}`}>
          <Image
            src={img}
            alt={p.alt}
            widths={[640, 960, 1400, 2000].filter((w) => w <= img.width).concat(img.width < 640 ? [img.width] : [])}
            sizes="(max-width: 900px) 90vw, 900px"
            loading="eager"
            fetchpriority="high"
            transition:name={`art-${p.slug}`}
          />
        </button>
      </div>

      {realSize && (
        <div class="view" data-pane="room" hidden>
          <div class="room" role="img" aria-label={`${p.title} shown to scale, ${realSize.w} by ${realSize.h} mm, hanging above a 1.2 metre sideboard`}>
            <span class="room-floor" aria-hidden="true"></span>
            <img
              class="room-art"
              src={full.src}
              alt=""
              loading="lazy"
              style={`width:${(realSize.w / ROOM_W) * 100}%;bottom:${(HANG / ROOM_H) * 100}%`}
            />
            <span class="room-furniture" aria-hidden="true">
              <svg viewBox="0 0 1200 760" fill="currentColor">
                <rect x="0" y="0" width="1200" height="26" />
                <rect x="16" y="26" width="1168" height="584" opacity="0.72" />
                <rect x="400" y="60" width="2" height="520" fill="#ebe7e0" />
                <rect x="798" y="60" width="2" height="520" fill="#ebe7e0" />
                <rect x="360" y="300" width="22" height="3" fill="#ebe7e0" />
                <rect x="818" y="300" width="22" height="3" fill="#ebe7e0" />
                <path d="M70 610h22l-14 150h-8zM1108 610h22l-0 150h-8z" />
              </svg>
            </span>
          </div>
        </div>
      )}

      <div class="wall-bar">
        <span>Select the painting to enlarge</span>
        {realSize && (
          <div class="view-switch" role="group" aria-label="How to show the painting">
            <button type="button" data-view="wall" aria-pressed="true">On the wall</button>
            <button type="button" data-view="room" aria-pressed="false">In a room, to scale</button>
          </div>
        )}
      </div>
    </div>
  </section>

  <article class="wrap work-info">
    <div>
      <p class="eyebrow">{p.series ?? c.name}{p.year && ` · ${p.year}`}</p>
      <h1>{p.title}</h1>
      {p.note && <p class="note">{p.note}</p>}
    </div>

    <div class="work-side">
      {(p.medium || p.size || p.year || p.availability) && (
        <dl class="facts">
          {p.medium && (<><dt>Medium</dt><dd>{p.medium}</dd></>)}
          {p.size && (<><dt>Size</dt><dd>{p.size}</dd></>)}
          {p.year && (<><dt>Year</dt><dd>{p.year}</dd></>)}
          {p.availability && (<><dt>Availability</dt><dd>{p.availability}</dd></>)}
        </dl>
      )}
      <div class="actions">
        <a class="btn btn-solid" href={enquiryLink(`Enquiry: ${p.title}`)}>Enquire about this painting</a>
        <a class="btn" href={enquiryLink(`Commission enquiry (similar to ${p.title})`)}>Commission something similar</a>
      </div>
      <p class="muted" style="font-size:15px">Enquiries go straight to Ross by email.</p>
    </div>
  </article>

  <div class="wrap">
    <nav class="pager" aria-label="Previous and next painting">
      <a href={`/${prev.slug}/`}><small>← Previous</small><b>{prev.title}</b></a>
      <a href={`/${next.slug}/`}><small>Next →</small><b>{next.title}</b></a>
    </nav>
  </div>

  <section class="wrap more">
    <div class="section-head">
      <div>
        <p class="eyebrow">Also in {c.name}</p>
        <h2 class="h-section">More paintings</h2>
      </div>
      <a class="caps link-arrow" href={`/${c.slug}/`}>View all {siblings.length} <span>→</span></a>
    </div>
    <div class="salon">
      {more.map((m, i) => <PaintingCard painting={m} index={i} number={i + 1} />)}
    </div>
  </section>

  <dialog class="lightbox" aria-label={`${p.title}, enlarged`}>
    <button class="lightbox-close" type="button" aria-label="Close">×</button>
    <div class="lightbox-stage">
      <img src={full.src} alt={p.alt} loading="lazy" decoding="async" />
    </div>
  </dialog>
</Layout>
