---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <div class="wrap">
    <header class="intro" style="padding-bottom:140px">
      <div>
        <p class="eyebrow">Page not found</p>
        <h1>That page isn’t here.</h1>
      </div>
      <p class="body" style="font-size:19px">It may have moved when the site was rebuilt.</p>
      <p><a class="btn btn-solid" href="/">Back to the paintings</a></p>
    </header>
  </div>
</Layout>
