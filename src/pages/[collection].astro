---
import Layout from '../layouts/Layout.astro';
import PaintingCard from '../components/PaintingCard.astro';
import { getImage } from 'astro:assets';
import { paintings, imageFor } from '../data/paintings';
import { collections, type CollectionKey } from '../data/site';

export function getStaticPaths() {
  return (Object.keys(collections) as CollectionKey[]).map((key) => ({
    params: { collection: collections[key].slug },
    props: { key },
  }));
}
const { key } = Astro.props as { key: CollectionKey };
const c = collections[key];
const all = paintings.filter((p) => p.collection === key);
const main = all.filter((p) => !p.series);
const seriesNames = [...new Set(all.filter((p) => p.series).map((p) => p.series!))];
const og = await getImage({ src: imageFor(c.cover), width: 1200, format: 'jpg' });
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<Layout title={c.name} description={`${c.name} by Ross Palmer. ${c.blurb}`} image={og.src} current={key}>
  <div class="wrap">
    <header class="intro">
      <p class="eyebrow">{all.length} paintings</p>
      <h1>{c.name}</h1>
      <p class="body" style="font-size:19px">{c.blurb}</p>
    </header>

    <section class="section">
      <div class="grid">
        {main.map((p, i) => <PaintingCard painting={p} index={i} />)}
      </div>

      {seriesNames.map((name) => (
        <>
          <div class="series-head" id={slugify(name)} data-reveal>
            <p class="eyebrow">Series</p>
            <h2 class="h-section">{name}</h2>
          </div>
          <div class="grid">
            {all.filter((p) => p.series === name).map((p, i) => <PaintingCard painting={p} index={i} />)}
          </div>
        </>
      ))}
    </section>
  </div>
</Layout>
