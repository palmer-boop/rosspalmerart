---
import Layout from '../layouts/Layout.astro';
import { site, enquiryLink } from '../data/site';
---
<Layout title="Contact" description="Contact Ross Palmer about a painting or a commission." current="contact">
  <div class="wrap">
    <header class="intro">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Get in <em>touch.</em></h1>
      </div>
    </header>
    <div class="prose" style="padding-bottom:120px">
      <p class="lead">
        If you would like to ask about a painting, or have one painted for you, please email me directly.
      </p>
      <a class="email-big" href={enquiryLink('Enquiry from rosspalmerart.com')}>{site.email}</a>
      <p class="muted" style="font-size:16px">{site.location}</p>
    </div>
  </div>
</Layout>
